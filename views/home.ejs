<!DOCTYPE html>
<html>
<head>
    <title>Spider Dashboard</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #0b0b0b;
            color: white;
        }

        h1 {
            text-align: center;
            color: #ff1a1a;
            padding: 20px;
        }

        .upload-box {
            text-align: center;
            padding: 20px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            padding: 20px;
        }

        .card {
            background: #111;
            padding: 10px;
            border-radius: 10px;
        }

        img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
        }

        .actions {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 14px;
        }

        a, button {
            color: #ff1a1a;
            text-decoration: none;
            background: none;
            border: none;
            cursor: pointer;
        }

        form {
            display: inline;
        }
    </style>
</head>

<body>

<h1>🕷 Spider Gallery</h1>

<h2 style="text-align:center;">Total Uploads: <%= count %></h2>

<!-- UPLOAD FORM -->
<div class="upload-box">
    <form action="/user/upload-file" method="POST" enctype="multipart/form-data">
        <input type="file" name="file" required>
        <button type="submit">UPLOAD</button>
    </form>
</div>

<!-- GALLERY -->
<div class="grid">

<% images.forEach(img => { %>

    <div class="card">

        <img src="<%= img.secure_url %>">

        <div class="actions">

            <a href="<%= img.secure_url %>" target="_blank">👁 View</a>

            <a href="<%= img.secure_url %>" download>⬇ Download</a>

            <form action="/user/delete-image" method="POST">
                <input type="hidden" name="publicId" value="<%= img.public_id %>">
                <button>❌ Delete</button>
            </form>

        </div>

    </div>

<% }) %>

</div>

</body>
</html>

