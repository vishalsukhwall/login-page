<!DOCTYPE html>
<html>
<head>
  <title>Welcome</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body {
      margin: 0;
      height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      background: radial-gradient(circle at top, #0a0a0f, #000);
      font-family: Arial;
    }

    /* glow background */
    body::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 30% 30%, rgba(229,9,20,0.25), transparent 40%),
        radial-gradient(circle at 70% 70%, rgba(255,0,0,0.15), transparent 40%);
      filter: blur(40px);
    }

    .glass {
      background: rgba(255,255,255,0.06);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.1);
      padding: 50px;
      border-radius: 25px;
      text-align: center;
      box-shadow: 0 0 80px rgba(229,9,20,0.25);

      opacity: 0;
      transform: scale(0.8);
      animation: pop 1s ease forwards;
      z-index: 2;
    }

    @keyframes pop {
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .spider {
      font-size: 60px;
      animation: float 3s infinite ease-in-out;
    }

    @keyframes float {
      0% { transform: translateY(0); }
      50% { transform: translateY(-15px); }
      100% { transform: translateY(0); }
    }

    .title {
      font-size: 40px;
      font-weight: bold;
      color: #e50914;
      text-shadow: 0 0 25px rgba(229,9,20,0.8);
    }

    .btn {
      margin-top: 20px;
      display: inline-block;
      padding: 10px 25px;
      background: linear-gradient(135deg, #e50914, #8b0000);
      border-radius: 10px;
      transition: 0.3s;
    }

    .btn:hover {
      transform: scale(1.1);
      box-shadow: 0 0 25px rgba(229,9,20,0.6);
    }

    canvas {
      position: absolute;
      top: 0;
      left: 0;
    }
  </style>
</head>

<body>

<!-- 🎉 CONFETTI CANVAS -->
<canvas id="confetti"></canvas>

<!-- 🔊 SOUND -->
<audio autoplay>
  <source src="https://www.soundjay.com/buttons/sounds/button-16.mp3" type="audio/mpeg">
</audio>

<div class="glass">

  <div class="spider">🕷️</div>

  <div class="title">WELCOME</div>

  <p>Account Created Successfully</p>

  <h1 style="margin-top:20px">
    Hey <span style="color:#ef0813"><%= user %></span>
  </h1>

  <p style="opacity:0.7">You are now part of Spider-Verse</p>

  <a href="/user/login" class="btn text-white">
    Enter →
  </a>

</div>

<script>
/* 🎉 SIMPLE CONFETTI */
const canvas = document.getElementById("confetti");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

let pieces = [];

for (let i = 0; i < 100; i++) {
  pieces.push({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    r: Math.random() * 6 + 2,
    d: Math.random() * 10
  });
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = "#e50914";

  pieces.forEach(p => {
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    ctx.fill();

    p.y += 2;
    if (p.y > canvas.height) p.y = 0;
  });

  requestAnimationFrame(draw);
}

draw();
</script>

</body>
</html>