<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Spider | Marvel UI</title>

<style>
:root {
    --bg: #050507;
    --accent: #e50914;
    --text: #f5f5f5;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Inter, sans-serif;
}

body {
    height: 100vh;
    background: radial-gradient(circle at top, #0a0a0f, #000);
    color: var(--text);
    overflow: hidden;
    position: relative;
}

/* 🔥 CINEMATIC LIGHT */
body::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 30% 20%, rgba(229,9,20,0.2), transparent 40%),
        radial-gradient(circle at 80% 80%, rgba(229,9,20,0.15), transparent 40%);
    z-index: 0;
}

/* 🎬 VIGNETTE (movie feel) */
body::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, transparent 40%, rgba(0,0,0,0.9));
    z-index: 1;
}

/* 🕸️ SVG WEB OVERLAY */
.web {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    z-index: 1;
}

/* 🕷️ BIG BRAND TEXT */
.bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 220px;
    font-weight: 900;
    letter-spacing: 25px;
    color: rgba(229,9,20,0.07);
    z-index: 1;
}

/* 🧊 MAIN CARD */
.container {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.card {
    width: 420px;
    padding: 40px;
    border-radius: 18px;

    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(20px);

    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 
        0 20px 60px rgba(0,0,0,0.8),
        inset 0 0 40px rgba(229,9,20,0.05);

    text-align: center;
    transition: 0.4s;
}

.card:hover {
    transform: translateY(-8px) scale(1.01);
}

/* TEXT */
h1 {
    font-size: 30px;
    font-weight: 700;
}

.highlight {
    color: var(--accent);
}

p {
    margin-top: 12px;
    opacity: 0.7;
}

/* IMAGE */
.user-img {
    width: 100%;
    margin-top: 20px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
}

/* BUTTON */
.btn {
    margin-top: 30px;
    width: 100%;
    padding: 13px;
    border-radius: 10px;
    border: none;
    background: linear-gradient(135deg, #e50914, #8b0000);
    color: white;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 1px;
    transition: 0.3s;
}

.btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(229,9,20,0.6);
}

/* 🕷️ FLOATING SPIDER */
.spider {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    font-size: 22px;
    animation: swing 3s infinite ease-in-out alternate;
    z-index: 2;
}

@keyframes swing {
    from { transform: translateX(-50%) rotate(-8deg); }
    to { transform: translateX(-50%) rotate(8deg); }
}

</style>
</head>

<body>

<!-- 🕸️ SVG WEB -->
<svg class="web" viewBox="0 0 800 800">
    <circle cx="400" cy="400" r="300" stroke="white" fill="none"/>
    <circle cx="400" cy="400" r="200" stroke="white" fill="none"/>
    <circle cx="400" cy="400" r="100" stroke="white" fill="none"/>
    <line x1="400" y1="0" x2="400" y2="800" stroke="white"/>
    <line x1="0" y1="400" x2="800" y2="400" stroke="white"/>
</svg>

<!-- 🕷️ BRAND -->
<div class="bg-text">SPIDER</div>

<div class="spider">🕷️</div>

<!-- 🎯 MAIN -->
<div class="container">
    <div class="card">

        <h1>Welcome, <span class="highlight"><%= username %></span></h1>

        <p>Marvel-grade Spider interface initialized.</p>

        <% if (typeof imageUrl !== 'undefined') { %>
            <img src="<%= imageUrl %>" class="user-img">
        <% } %>

        <button class="btn" onclick="goUpload()">ENTER SYSTEM</button>

    </div>
</div>

<script>
function goUpload(){
    window.location.href = "/upload";
}
</script>

</body>
</html>